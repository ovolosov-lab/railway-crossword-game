# Copy this file to .env and replace placeholder values for your environment.
APP_NAME=Railway
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:your_postgress_password@db:5432/game

DB_USER=postgres
DB_PASSWORD=your_postgress_password
DB_HOST=localhost  
DB_PORT=5432
DB_NAME=game
JWT_SECRET=replace_with_random_secret_of_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_SAMESITE=lax
DEBUG=False
FRIEND_REFERENCE=your_secret_word_for_registration_you_will_tell_your_friends
POOL_SIZE=5
MAX_OVERFLOW=5
LOG_FILE=logs/game.log
LOG_ROTATION=12 MB
LOG_RETENTION=2 days
MIN_WORD_LEN=3
MAX_WORD_LEN=8
GAME_DURATION_HOURS=24
CHECK_INTERVAL=40
USER_GUESS_RATE_LIMIT=30
FRONTEND_SYNC_INTERVAL=2
HINT_FIRST_LETTER_COST=20
HINT_LAST_LETTER_COST=30
AI_API_PATH=your_path_to_the_model 
AI_API_KEY=your_api_key_to_the_model